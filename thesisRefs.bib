@article{hulseDispersiveModelsFinitedifference1994,
    title = {Dispersive models for the finite-difference time-domain method: design, analysis, and implementation},
    copyright = {© 1994 Optical Society of America},
    shorttitle = {Dispersive models for the finite-difference time-domain method},
    url = {https://opg.optica.org/josaa/abstract.cfm?uri=josaa-11-6-1802},
    doi = {10.1364/JOSAA.11.001802},
    abstract = {Digital signal processing techniques are used to design, analyze, and implement discrete models of polarization dispersion in finite-difference time-domain (FDTD) simulations. These methods are warranted by the extreme importance of dispersion to the propagation behavior of femtosecond-duration optical pulses. Input-invariant and frequency-approximation methods of designing discrete analogs of continuous-time dispersive electromagnetic systems are presented. Our methods are shown to unify existing design techniques. The inherent accuracy of each dispersive design is quantified by truncation error and frequency response methods, and stability analysis of the total FDTD system is found through root locus techniques. Implementation of the design is accomplished by algebraic manipulation of the system function in the frequency domain, resulting in canonical, partial fraction, or cascade structures that minimize the number of stored variables and provide a trade-off between efficiency and sensitivity to finite precision.},
    language = {EN},
    urldate = {2026-07-28},
    journal = {JOSA A, Vol. 11, Issue 6, pp. 1802-1811},
    publisher = {Optica Publishing Group},
    author = {Hulse, Charles and Knoesen, André},
    month = jun,
    year = {1994},
    keywords = {Dispersion, Finite-difference time-domain method, Fourier transforms, Phase shift, Signal processing, Systems design},
}
@misc{mounetElectromagneticFieldsBeam2010,
    title = {Electromagnetic fields and beam coupling impedances in a multilayer flat chamber},
    url = {https://cds.cern.ch/record/1314524},
    abstract = {This paper aims at giving a derivation of the six electromagnetic field components created by an offset point charge travelling at any speed in a flat chamber, i.e. a two dimensional structure consisting of two infinite parallel plates surrounding a vacuum region. The plates are infinite both horizontally and along the direction of the point charge movement. We study the general case where the two plates are made of several layers of linear materials up to infinity in the vertical direction, with no a priori top-bottom symmetry. We find new results for the electromagnetic fields and impedances, generalizing in particular the so-called ``Yokoya factors'' that are valid under certain conditions only.},
    urldate = {2026-07-28},
    author = {Mounet, N and Métral, E},
    year = {2010},
}
@article{biancacciModeMatchingTechnique2014,
    title = {The mode matching technique applied to the transverse beam coupling impedance calculation of azimuthally symmetric devices of finite length},
    url = {https://cds.cern.ch/record/1742043},
    abstract = {The infinite length approximation is often used to simplify the calculation of the beam coupling impedance of accelerator elements. This is expected to be a reasonable assumption for devices whose length is greater than the transverse dimension but may be a less accurate approximation for segmented devices. In this contribution we present the extension of the study of the beam coupling impedance of a finite length device to the transverse plane. In order to take into account the finite length, we decompose the fields in the cavity and in the beam pipe into a set of orthonormal modes and apply the Mode Matching method to obtain the impedance. To validate our method, we will present comparisons between analytical formulas and 3D electromagnetic CST simulations.},
    urldate = {2026-07-28},
    author = {Biancacci, N and Métral, E and Salvant, B and Zannini, C and Vaccaro, V G and Migliorati, M and Palumbo, L},
    year = {2014},
}
@article{farjadpourImprovingAccuracySubpixel2006,
    title = {Improving accuracy by subpixel smoothing in the finite-difference time domain},
    volume = {31},
    copyright = {© 2006 Optical Society of America},
    issn = {1539-4794},
    url = {https://opg.optica.org/ol/abstract.cfm?uri=ol-31-20-2972},
    doi = {10.1364/OL.31.002972},
    abstract = {Finite-difference time-domain (FDTD) methods suffer from reduced accuracy when modeling discontinuous dielectric materials, due to the inhererent discretization (pixelization). We show that accuracy can be significantly improved by using a subpixel smoothing of the dielectric function, but only if the smoothing scheme is properly designed. We develop such a scheme based on a simple criterion taken from perturbation theory and compare it with other published FDTD smoothing methods. In addition to consistently achieving the smallest errors, our scheme is the only one that attains quadratic convergence with resolution for arbitrarily sloped interfaces. Finally, we discuss additional difficulties that arise for sharp dielectric corners.},
    language = {EN},
    number = {20},
    urldate = {2026-07-28},
    journal = {Optics Letters},
    publisher = {Optica Publishing Group},
    author = {Farjadpour, A. and Roundy, David and Rodriguez, Alejandro and Ibanescu, M. and Bermel, Peter and Joannopoulos, J. D. and Johnson, Steven G. and Burr, G. W.},
    month = oct,
    year = {2006},
    keywords = {Anisotropy, Finite-difference time-domain method, Permittivity, Photonic crystals, Resolution, Thulium},
    pages = {2972--2974},
}
@article{oskooiAccurateFinitedifferenceTimedomain2009,
    title = {Accurate finite-difference time-domain simulation of anisotropic media by subpixel smoothing},
    volume = {34},
    copyright = {© 2009 Optical Society of America},
    issn = {1539-4794},
    url = {https://opg.optica.org/ol/abstract.cfm?uri=ol-34-18-2778},
    doi = {10.1364/OL.34.002778},
    abstract = {Finite-difference time-domain methods suffer from reduced accuracy when discretizing discontinuous materials. We previously showed that accuracy can be significantly improved by using subpixel smoothing of the isotropic dielectric function, but only if the smoothing scheme is properly designed. Using recent developments in perturbation theory that were applied to spectral methods, we extend this idea to anisotropic media and demonstrate that the generalized smoothing consistently reduces the errors and even attains second-order convergence with resolution.},
    language = {EN},
    number = {18},
    urldate = {2026-07-28},
    journal = {Optics Letters},
