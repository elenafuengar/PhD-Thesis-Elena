    keywords = {Adaptive mesh refinement, Codes, Computational modeling, Electron accelerators, Exascale computing, High performance computing, Particle-In-Cell method, Plasma accelerators, Solid modeling, Supercomputers, Technological innovation, Three-dimensional displays, high-field science, laser-matter interaction},
